{
  "schemaVersion": "1.0",

  "form": {
    "id": "sample-tax-form",
    "taxYear": 2025,
    "units": "pt",
    "coordinateSystem": "top-left"
  },

  "annotations": [
    {
      "id": "taxpayer.firstName",
      "type": "text",

      "source": {
        "path": "$.taxpayer.name.first"
      },

      "target": {
        "page": 1,
        "box": {
          "x": 100,
          "y": 100,
          "width": 150,
          "height": 20
        }
      },

      "format": {
        "fontFamily": "Helvetica",
        "fontSize": 10,
        "alignment": "left",
        "verticalAlignment": "middle"
      },

      "behavior": {
        "missingValue": "skip",
        "overflow": "shrink",
        "minFontSize": 7
      }
    },

    {
      "id": "taxpayer.zip",
      "type": "text",

      "source": {
        "path": "$.taxpayer.address.zip"
      },

      "target": {
        "page": 1,
        "box": {
          "x": 450,
          "y": 140,
          "width": 70,
          "height": 20
        }
      },

      "format": {
        "fontFamily": "Helvetica",
        "fontSize": 10,
        "alignment": "left",
        "verticalAlignment": "middle"
      }
    },

    {
      "id": "income.wages",
      "type": "currency",

      "source": {
        "path": "$.income.wages"
      },

      "target": {
        "page": 1,
        "box": {
          "x": 450,
          "y": 300,
          "width": 100,
          "height": 20
        }
      },

      "format": {
        "fontFamily": "Helvetica",
        "fontSize": 10,
        "alignment": "right",
        "verticalAlignment": "middle",
        "currency": "USD",
        "decimals": 2
      }
    },

    {
      "id": "filing.single",
      "type": "checkbox",
      "source": {
        "path": "$.taxpayer.filingStatus"
      },
      "target": {
        "page": 1,
        "box": {
          "x": 100,
          "y": 200,
          "width": 15,
          "height": 15
        }
      },
      "condition": {
        "operator": "equals",
        "value": "single"
      }
    }
  ]
}
